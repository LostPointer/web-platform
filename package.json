{
  "name": "@lostpointer/web-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "pnpm build && vitest run",
    "check:exports": "pnpm build && pnpm -r --if-present check:exports",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:exports",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@changesets/cli": "^2.29.8",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "publint": "^0.3.16",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.16"
  }
}
