{
  "name": "@lostpointer/web-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm build && tsc -b",
    "test": "pnpm build && vitest run",
    "check:exports": "pnpm build && pnpm -r --if-present check:exports",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:exports && pnpm build-storybook",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.1",
    "@mui/material": "^7.3.9",
    "@storybook/react-vite": "^10.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "publint": "^0.3.16",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass": "^1.102.0",
    "storybook": "^10.5.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.16"
  }
}
