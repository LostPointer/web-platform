{
  "name": "@lostpointer/web-tokens",
  "version": "0.1.1",
  "description": "Canonical design tokens for LostPointer web applications.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./variables.css": "./dist/variables.css",
    "./variables.scss": "./dist/variables.scss"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "pnpm generate:check && tsup src/index.ts --format esm --dts --clean && cp src/variables.css src/variables.scss dist/",
    "prepack": "pnpm build",
    "check:exports": "publint"
  },
  "publishConfig": {
    "access": "public"
  }
}
