{
  "name": "@lostpointer/web-styles",
  "version": "0.0.0",
  "description": "Shared browser-safe base styles for LostPointer web applications.",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./reset.css": "./dist/reset.css",
    "./base.css": "./dist/base.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": ["**/*.css"],
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@lostpointer/web-tokens": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && cp src/*.css dist/",
    "check:exports": "publint"
  },
  "publishConfig": {
    "access": "public"
  }
}
